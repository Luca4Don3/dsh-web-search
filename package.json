{
  "name": "dsh-web-search",
  "version": "0.1.1",
  "description": "DSH 独立聚合搜索提供方：匿名优先、费用授权、额度预检与有界取消",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./core": { "types": "./lib/core/index.d.ts", "default": "./lib/core/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:artifacts": "node tests/check-artifacts.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "npm run build && node tests/smoke.mjs"
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "dsh": { "bundle": { "patch": "cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "undici": "^7.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2"
  }
}
